  "author": "ojoxux",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "husky": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "husky": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ojoxux/ojisan-branch-guard"
  }
